# Local-dev env template. Copy to .env and fill in — .env is git-ignored.
#   cp .env.example .env
#
# The deployed Databricks App reads the Lakebase URL from the `database/lakebase-url`
# secret (see app.yaml). For LOCAL runs you can either:
#   (a) set LAKEBASE_URL directly below (a full Postgres URL), OR
#   (b) leave it blank and have a Databricks CLI profile configured, so
#       lakebase.py resolves the URL from the secret scope automatically.

# (a) Direct connection URL (preferred for local dev / Colab / any non-Databricks box):
LAKEBASE_URL=postgresql://role:password@host.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# Secret scope/key fallback (used when LAKEBASE_URL is unset and a CLI profile exists):
LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

# Foundation Model endpoints for the in-app agent + explanations (optional locally).
PLANNER_AGENT_MODEL=databricks-meta-llama-3-3-70b-instruct
PLANNER_EXPLAIN_MODEL=databricks-meta-llama-3-1-8b-instruct

# Reschedule thresholds (optional overrides).
RAIN_PRECIP_CHANCE_PCT=50
RAIN_PRECIP_AMOUNT=0.1
AQI_UNHEALTHY_THRESHOLD=100
